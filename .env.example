# DineEQR by Black Cardinal — Environment Variables Template
# ==============================================================================
# SECURITY NOTICE:
# 1. NEVER commit a real .env file or production credentials into git repositories.
# 2. Configure server-side variables in your Netlify Dashboard under:
#    Site configuration > Environment variables
# 3. Rotate administrator passwords immediately if any previous credentials were
#    shared or committed in repository history.
# ==============================================================================

# --- Server-Side Environment Variables (Netlify Serverless Functions) ---

# Administrator Username for dashboard access
ADMIN_USERNAME=admin

# Strong Administrator Password (Generate a high-entropy password >= 16 characters)
# Example generation: openssl rand -base64 24
ADMIN_PASSWORD=replace_with_your_strong_production_password_here

# (Optional) Pre-hashed PBKDF2 administrator password for enhanced at-rest protection
# Format: pbkdf2:<salt_hex>:<iterations>:<hash_hex>
# ADMIN_PASSWORD_HASH=pbkdf2:a1b2c3d4e5f6:100000:7a8b9c...

# Cryptographic Secret for HMAC-SHA256 session token signatures (Minimum 64 chars)
# Generate using: openssl rand -hex 32
SESSION_SECRET=replace_with_a_64_character_cryptographically_secure_random_string

# Session token validity duration in hours (Default: 8, Min: 1, Max: 72)
SESSION_EXPIRY_HOURS=8


# --- Client-Side Environment Variables (Safe for Public Bundling) ---

# Public Canonical Site URL
VITE_SITE_URL=https://dineeqr.netlify.app
