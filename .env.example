# DineEQR by Black Cardinal — Environment Variables Example
# ==============================================================================
# IMPORTANT:
# 1. Do NOT put production secrets in client-facing VITE_ variables!
#    Vite variables prefixed with VITE_ are bundled into client JavaScript.
# 2. Server-side variables (ADMIN_*, SESSION_*) MUST be configured in the
#    Netlify Dashboard under: Site configuration > Environment variables.
# ==============================================================================

# --- Server-Side Environment Variables (Netlify Functions Only) ---

# Administrator Username for dashboard access
ADMIN_USERNAME=admin

# Strong Administrator Password (Change this immediately before production deployment!)
ADMIN_PASSWORD=change_this_to_a_strong_random_password_in_production

# Cryptographic Secret for HMAC-SHA256 session token signatures
# Generate a secure 64-char key using: openssl rand -hex 32
SESSION_SECRET=replace_with_a_64_character_cryptographically_secure_random_string

# Session token validity duration in hours (Default: 8)
SESSION_EXPIRY_HOURS=8


# --- Client-Side Environment Variables (Publicly Safe) ---

# Public Canonical Site URL
VITE_SITE_URL=https://dineeqr.blackcardinal.in

# Local Offline Development Fallback Only (MUST BE false in production)
VITE_ENABLE_MOCK_AUTH=false
